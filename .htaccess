# API host (Node + Passenger) only — not for the SPA frontend.
# Apache may answer OPTIONS before Node; these headers satisfy browser CORS.

<IfModule mod_headers.c>
  SetEnvIf Origin "^https://greenstoneng\.com$" CORS_GREENSTONENG=1
  SetEnvIf Origin "^https://www\.greenstoneng\.com$" CORS_GREENSTONENG_WWW=1
 

  Header always set Access-Control-Allow-Origin "https://greenstoneng.com" env=CORS_GREENSTONENG
  Header always set Access-Control-Allow-Origin "https://www.greenstoneng.com" env=CORS_GREENSTONENG_WWW
  

  Header always set Access-Control-Allow-Credentials "true" env=CORS_GREENSTONENG
  Header always set Access-Control-Allow-Credentials "true" env=CORS_GREENSTONENG_WWW
  

  Header always set Access-Control-Allow-Methods "GET, HEAD, PUT, PATCH, POST, DELETE, OPTIONS" env=CORS_GREENSTONENG
  Header always set Access-Control-Allow-Methods "GET, HEAD, PUT, PATCH, POST, DELETE, OPTIONS" env=CORS_GREENSTONENG_WWW
  

  Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept" env=CORS_GREENSTONENG
  Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept" env=CORS_GREENSTONENG_WWW
  
</IfModule>

Options -Indexes
